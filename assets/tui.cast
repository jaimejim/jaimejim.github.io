[0.000, "o", "                   \u001b[0m\u001b[48;156H\u001b[38;2;205;206;207;48;2;0;0;0m  \u001b[0m\u001b[48;158H\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\r\n\u001b[49;23H\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48mI'm working on a simple directory service for agents called Agent Directory (AD). It lets agents register their base URI, \u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48m         \u001b[0m\u001b[49;156H\u001b[38;2;205;206;207;48;2;0;0;0m  \u001b[0m\u001b[49;158H\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\r\n\u001b[50;23H\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48mprotocols, and capabilities, and lets other agents look them up. Registrations are soft-state with configurable lifetimes.\u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48m         \u001b[0m\u001b[50;156H\u001b[38;2;205;206;207;48;2;0;0;0m  \u001b[0m\u001b[50;158H\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\r\n\u001b[51;23H\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48m            "]
[0.000, "o", "                                                                                                                       \u001b[0m\u001b[51;156H\u001b[38;2;205;206;207;48;2;0;0;0m  \u001b[0m\u001b[51;158H\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\r\n\u001b[52;23H\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48mThe API is small: register, refresh, remove, lookup. You can filter by capability name, domain, or protocol. It is \u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48m                \u001b[0m\u001b[52;156H\u001b[38;2;205;206;207;48;2;0;0;0m  \u001b[0m\u001b[52;158H\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\r\n\u001b[53;23H\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48mprotocol-agnostic - agents declare whatever interaction protocol they use (A2A, MCP, gRPC, etc.).\u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48m                                  \u001b[0m\u001b[53;156H\u001b[38;2;205;206;207;48;2;0;0;0m  \u001b[0m\u001b[53;158H\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\r\n\u001b[54;23H\u001b[38"]
[0.000, "o", ";2;57;80;109;48;2;25;35;48m│\u001b[0m\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48m                                                                                                                                   \u001b[0m\u001b[54;156H\u001b[38;2;205;206;207;48;2;0;0;0m  \u001b[0m\u001b[54;158H\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\r\n\u001b[55;23H\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48mThis is just a tiny building block, in the spirit of how IETF does things.\u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48m                                                         \u001b[0m\u001b[55;156H\u001b[38;2;205;206;207;48;2;0;0;0m  \u001b[0m\u001b[55;158H\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\r\n\u001b[56;23H\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48m                                                                                                                                   \u001b[0m\u001b[56;156H\u001b[38;2;205;206;207;48;2;0;0;0m  \u001b[0m\u001b[56;158H\u001b[48;2;25;"]
