[0.000, "o", ";48m                                                                                                                            \u001b[0m\u001b[47;156H\u001b[38;2;205;206;207;48;2;0;0;0m  \u001b[0m\u001b[47;158H\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\r\n\u001b[48;23H\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48m                                                                                                                                   \u001b[0m\u001b[48;156H\u001b[38;2;205;206;207;48;2;0;0;0m  \u001b[0m\u001b[48;158H\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\r\n\u001b[49;23H\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48mI'm working on a simple directory service for agents called Agent Directory (AD). It lets agents register their base URI, \u001b[0m\u001b[38;2;205;206;207;48;2;25;35;48m         \u001b[0m\u001b[49;156H\u001b[38;2;205;206;207;48;2;0;0;0m  \u001b[0m\u001b[49;158H\u001b[48;2;25;35;48m \u001b[0m\u001b[38;2;57;80;109;48;2;25;35;48m│\u001b[0m\r\n\u001b[50;23H\u001b[38;2;57;80;109;48;2;25;35;48m"]
